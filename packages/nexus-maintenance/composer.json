{
    "name": "nexus/maintenance",
    "description": "Mobile game features for Laravel including maintenance mode management with support for AWS DynamoDB and Alibaba Cloud TableStore",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Your Name",
            "email": "your.email@example.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "nexus/core": "@dev",
        "illuminate/support": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/cache": "^13.0",
        "nesbot/carbon": "^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0",
        "aws/aws-sdk-php": "^3.0",
        "aliyun/aliyun-tablestore-sdk-php": "^6.0"
    },
    "suggest": {
        "aws/aws-sdk-php": "Required for AWS DynamoDB storage driver (^3.0)",
        "aliyun/aliyun-tablestore-sdk-php": "Required for Alibaba Cloud TableStore storage driver"
    },
    "autoload": {
        "psr-4": {
            "NexusMaintenance\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NexusMaintenance\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NexusMaintenance\\MaintenanceServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
