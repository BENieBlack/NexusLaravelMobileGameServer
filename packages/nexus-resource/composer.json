{
    "name": "nexus/resource",
    "description": "Unified resource representation for game resources (Diamond, Unit, Equipment, Coin, Item, etc.)",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nexus Team",
            "email": "team@nexus.example.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ramsey/uuid": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "NexusResource\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NexusResource\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
