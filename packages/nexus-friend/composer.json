{
    "name": "nexus/friend",
    "description": "Friend management package for Nexus mobile game",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "nexus/core": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "NexusFriend\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NexusFriend\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
