{
    "name": "s-nakamura/laravel-security-middleware",
    "description": "Laravel security middleware包包括客户端签名验证、幂等性保证、速率限制和访问令牌验证",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "S. Nakamura"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/cache": "^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "LaravelSecurityMiddleware\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelSecurityMiddleware\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelSecurityMiddleware\\SecurityMiddlewareServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
