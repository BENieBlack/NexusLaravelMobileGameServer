{
    "name": "nexus/mailbox",
    "description": "Mailbox management package for Nexus mobile game",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "nexus/core": "@dev",
        "nexus/resource-delivery": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "illuminate/support": "^11.0|^12.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "NexusMailbox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NexusMailbox\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../nexus-resource-delivery"
        },
        {
            "type": "path",
            "url": "../nexus-resource"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "NexusMailbox\\MailboxServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
