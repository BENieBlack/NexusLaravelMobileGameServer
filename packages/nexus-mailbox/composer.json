{
    "name": "nexus/mailbox",
    "description": "Mailbox management package for Nexus mobile game",
    "type": "library",
    "require": {
        "php": "^8.1",
        "nexus/utilities": "@dev",
        "nexus/resource-delivery": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "illuminate/support": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "NexusMailbox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NexusMailbox\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

