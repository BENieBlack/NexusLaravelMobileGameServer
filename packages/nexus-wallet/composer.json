{
    "name": "nexus/wallet",
    "description": "Virtual currency wallet management for Laravel with FIFO consumption and expiration support",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Your Name",
            "email": "your.email@example.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "nexus/core": "@dev",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "nesbot/carbon": "^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "NexusWallet\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NexusWallet\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NexusWallet\\WalletServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
