ENV=local

# アプリケーション基本設定
# APP_KEY は setup.sh が自動生成する（空のまま置いておく）
APP_NAME=nexus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# メンテナンス機能のストレージドライバー: database, dynamodb, tablestore
MAINTENANCE_DRIVER=database

# Client Authentication
# クライアント認証用の秘密鍵
# 以下はサンプル値であり、リポジトリが公開されているため誰でも知り得る。
# local以外の環境でこの値のまま起動すると、署名検証が起動時にエラーで落ちる。
# 生成方法: openssl rand -hex 32
CLIENT_SECRET=your-secret-key-here-change-in-production

# ログ
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker MySQL の root パスワード（docker-compose.yml が参照する）
MYSQL_ROOT_PASSWORD=root

# TrxDB/LogDBのシャード数（trx1..trxN と log1..logN が生成される）
# docker-compose.yml が定義しているコンテナ数（3）を超えないこと
DB_TRX_SHARDS=3

# API - システムDB
DB_SYSTEM_HOST=db-sys
DB_SYSTEM_PORT=3306
DB_SYSTEM_DATABASE=${APP_NAME}-${APP_ENV}-sys
DB_SYSTEM_USERNAME=root
DB_SYSTEM_PASSWORD=root

# API - マスターDB
DB_MASTER_HOST=db-mst
DB_MASTER_PORT=3306
DB_MASTER_DATABASE=${APP_NAME}-${APP_ENV}-mst
DB_MASTER_USERNAME=root
DB_MASTER_PASSWORD=root

# API - トランザクションDB（シャードごとに db-trx1..N / {DB名}1..N が割り当てられる）
DB_TRANSACTION_HOST=db-trx
DB_TRANSACTION_PORT=3306
DB_TRANSACTION_DATABASE=${APP_NAME}-${APP_ENV}-trx
DB_TRANSACTION_USERNAME=root
DB_TRANSACTION_PASSWORD=root

# API - ログDB（PITR用。trxと同じ番号どうしが対応する）
DB_LOG_HOST=db-log
DB_LOG_PORT=3306
DB_LOG_DATABASE=${APP_NAME}-${APP_ENV}-log
DB_LOG_USERNAME=root
DB_LOG_PASSWORD=root

# Tool - 管理者DB
DB_ADMIN_CONNECTION=mysql
DB_ADMIN_HOST=db-adm
DB_ADMIN_PORT=3306
DB_ADMIN_DATABASE=${APP_NAME}-${APP_ENV}-adm
DB_ADMIN_USERNAME=root
DB_ADMIN_PASSWORD=root

# Tool - 運営ツールDB
DB_TOOL_HOST=db-tol
DB_TOOL_PORT=3306
DB_TOOL_DATABASE=${APP_NAME}-${APP_ENV}-tol
DB_TOOL_USERNAME=root
DB_TOOL_PASSWORD=root

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# キャッシュ
CACHE_STORE=redis

# ----------------------------------------
# アプリ内課金
# ----------------------------------------
# Google Play: サービスアカウントJSONのパス、またはJSON文字列
# 未設定の場合、購入検証は PlatformApiException で失敗する
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT=

# App Store: App Store Connect の共有シークレット
APP_STORE_SHARED_SECRET=
