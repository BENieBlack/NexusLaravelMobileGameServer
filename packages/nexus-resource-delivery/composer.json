{
    "name": "nexus/resource-delivery",
    "description": "Resource delivery system for game resources with handler pattern and delayed delivery support",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nexus Team",
            "email": "team@nexus.example.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "nexus/resource": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "NexusResourceDelivery\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NexusResourceDelivery\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
