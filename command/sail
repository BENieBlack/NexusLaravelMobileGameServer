#!/usr/bin/env bash

# Determine the script directory and project root
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

cd "$PROJECT_ROOT"

# Compose v2 (docker compose) を優先し、無ければ v1 (docker-compose) にフォールバック
if docker compose version > /dev/null 2>&1; then
    COMPOSE=(docker compose)
elif command -v docker-compose > /dev/null 2>&1; then
    COMPOSE=(docker-compose)
else
    echo "Error: Docker Compose が見つかりません。"
    exit 1
fi

# 対象サービス。SAIL_SERVICE か --api / --tool / --service= で切り替える
SERVICE="${SAIL_SERVICE:-api-php}"

ARGS=()
for arg in "$@"; do
    if [ "$arg" = "--tool" ]; then
        SERVICE="tool-php"
    elif [ "$arg" = "--api" ]; then
        SERVICE="api-php"
    elif [[ "$arg" == --service=* ]]; then
        SERVICE="${arg#*=}"
    else
        ARGS+=("$arg")
    fi
done

# Export APP_SERVICE for Laravel Sail to use
export APP_SERVICE="$SERVICE"
export COMPOSE_FILE="$PROJECT_ROOT/docker-compose.yml"

# コンテナが起動していなければ起動する
ensure_docker_running() {
    echo "Checking Docker containers..."
    if ! "${COMPOSE[@]}" ps --status running --services 2> /dev/null | grep -q .; then
        echo "Starting Docker containers..."
        "${COMPOSE[@]}" up -d
        echo "Waiting for containers to be ready..."
        sleep 5
    else
        echo "Docker containers are already running."
    fi
}

# API・Tool のテスト実行
if [ "${ARGS[0]:-}" = "api" ] && [ "${ARGS[1]:-}" = "test" ]; then
    ensure_docker_running
    echo "Running API tests..."
    "${COMPOSE[@]}" exec -T api-php php vendor/bin/phpunit "${ARGS[@]:2}"
    exit $?
fi

if [ "${ARGS[0]:-}" = "tool" ] && [ "${ARGS[1]:-}" = "test" ]; then
    ensure_docker_running
    echo "Running Tool tests..."
    "${COMPOSE[@]}" exec -T tool-php php vendor/bin/phpunit "${ARGS[@]:2}"
    exit $?
fi

# マイグレーションは対象接続とパスの組み合わせが多いため make に集約している
if [ "${ARGS[0]:-}" = "migrate" ]; then
    echo "Error: マイグレーションは 'make migrate' を使ってください。"
    echo "  接続（sys / mst / trx1..N / log1..N）ごとにパスを指定する必要があります。"
    exit 1
fi

# Laravel Sail バイナリに委譲
if [ "$SERVICE" = "tool-php" ]; then
    exec "$PROJECT_ROOT/tool/vendor/bin/sail" "${ARGS[@]}"
else
    exec "$PROJECT_ROOT/api/vendor/bin/sail" "${ARGS[@]}"
fi
