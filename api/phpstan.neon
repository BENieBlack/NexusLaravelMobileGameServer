includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    # 解析対象のPHPバージョンを固定する。
    # 実行環境のPHPに追従させると、CIとローカルで結果が変わる。
    phpVersion: 80400
    paths:
        - app
        - ../packages/nexus-album/src
        - ../packages/nexus-chat/src
        - ../packages/nexus-core/src
        - ../packages/nexus-core-auth/src
        - ../packages/nexus-core-billing/src
        - ../packages/nexus-core-security/src
        - ../packages/nexus-core-unit-of-work/src
        - ../packages/nexus-friend/src
        - ../packages/nexus-gacha/src
        - ../packages/nexus-guild/src
        - ../packages/nexus-level/src
        - ../packages/nexus-login/src
        - ../packages/nexus-mailbox/src
        - ../packages/nexus-maintenance/src
        - ../packages/nexus-notification/src
        - ../packages/nexus-pitr/src
        - ../packages/nexus-resource/src
        - ../packages/nexus-resource-delivery/src
        - ../packages/nexus-stamina/src
        - ../packages/nexus-tidb/src
        - ../packages/nexus-version/src
        - ../packages/nexus-vip/src
        - ../packages/nexus-wallet/src
    excludePaths:
        - app/Providers/*
        - app/Console/*
    scanDirectories:
        - phpstan

    
    # カスタムルールの有効化
    bootstrapFiles:
        - phpstan/bootstrap.php

    ignoreErrors:
        # 複合主キーのモデルは $primaryKey に配列を入れ、getKeyName() も配列を返す
        # （App\Traits\CompositePrimaryKeyTrait）。
        # Laravel本体が string 前提のため必ず出るが、意図した実装なので無視する。
        # larastanが Model をスタブ済みでスタブの上書きができないため、ここで指定する。
        -
            identifier: property.defaultValue
            message: '#^Property .+\:\:\$primaryKey \(string\) does not accept default value of type array\<int, string\>\.$#'
        -
            identifier: property.phpDocType
            message: '#^PHPDoc type array\<string\> of property .+\:\:\$primaryKey is not covariant with PHPDoc type string of overridden property Illuminate\\Database\\Eloquent\\Model\:\:\$primaryKey\.$#'
        -
            identifier: method.childReturnType
            message: '#^Return type \(array\<int, string\>\) of method .+\:\:getKeyName\(\) should be compatible with return type \(string\) of method Illuminate\\Database\\Eloquent\\Model\:\:getKeyName\(\)$#'

        # パッケージが同梱するLaravel設定ファイル。config/配下ではないため
        # larastanのenv()チェックに引っかかるが、役割としては設定ファイルそのもので、
        # ServiceProviderからmergeConfigFrom()で読み込まれる。
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            paths:
                - ../packages/*/src/Config/*.php

rules:
    - App\PHPStan\Rules\NoDirectEloquentSaveInServiceRule
