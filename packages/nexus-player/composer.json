{
    "name": "nexus/player",
    "description": "Player management package for Nexus mobile game",
    "type": "library",
    "require": {
        "php": "^8.3",
        "nexus/utilities": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "NexusPlayer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NexusPlayer\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

