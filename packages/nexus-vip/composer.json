{
    "name": "nexus/vip",
    "description": "VIP point and level management system for mobile game servers",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Your Name",
            "email": "your.email@example.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "nesbot/carbon": "^2.0|^3.0",
        "nexus/core": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "NexusVip\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NexusVip\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../nexus-core-persistence"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "NexusVip\\VipServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
