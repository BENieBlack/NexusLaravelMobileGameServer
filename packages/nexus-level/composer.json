{
    "name": "nexus/level",
    "description": "Level management package for Nexus mobile game",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "NexusLevel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NexusLevel\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
