{
  "permissions": {
    "deny": [
      "Read(./api/vendor/**)",
      "Read(./tool/vendor/**)",
      "Read(./packages/*/vendor/**)",
      "Read(./api/node_modules/**)",
      "Read(./tool/node_modules/**)",
      "Read(./.claude/node_modules/**)",
      "Read(./api/storage/logs/**)",
      "Read(./api/storage/coverage/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pint-edited-file.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
