<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- 規約違反を静的に検出するテスト群 -->
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <!--
            パッケージのテストもここから実行する。
            各パッケージは path リポジトリとして api の vendor にオートロードされるため、
            パッケージ側の vendor / phpunit を用意しなくても実行できる。
        -->
        <testsuite name="Packages">
            <directory>../packages/*/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>../packages/nexus-core/src</directory>
            <directory>../packages/nexus-core-auth/src</directory>
            <directory>../packages/nexus-core-billing/src</directory>
            <directory>../packages/nexus-core-security/src</directory>
            <directory>../packages/nexus-core-unit-of-work/src</directory>
            <directory>../packages/nexus-friend/src</directory>
            <directory>../packages/nexus-gacha/src</directory>
            <directory>../packages/nexus-guild/src</directory>
            <directory>../packages/nexus-level/src</directory>
            <directory>../packages/nexus-login/src</directory>
            <directory>../packages/nexus-mailbox/src</directory>
            <directory>../packages/nexus-maintenance/src</directory>
            <directory>../packages/nexus-pitr/src</directory>
            <directory>../packages/nexus-resource/src</directory>
            <directory>../packages/nexus-resource-delivery/src</directory>
            <directory>../packages/nexus-stamina/src</directory>
            <directory>../packages/nexus-version/src</directory>
            <directory>../packages/nexus-vip/src</directory>
            <directory>../packages/nexus-wallet/src</directory>
        </include>
    </source>
    <php>
        <env name="APP_NAME" value="nexus"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_URL" value="http://localhost"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mst"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="REDIS_HOST" value="redis"/>
        <env name="REDIS_PORT" value="6379"/>

        <!-- Sharding Configuration for Testing -->
        <!-- テストは2シャード前提。
             force を付けないと、開発用の .env（DB_TRX_SHARDS=3）や
             CIのjob envが実環境変数として優先され、環境ごとに前提が変わってしまう。
             trx3 / log3 の接続情報は残してあるので、増やしたい場合はここを変える -->
        <env name="DB_TRX_SHARDS" value="2" force="true"/>

        <!-- System DB Testing -->
        <env name="DB_SYSTEM_HOST" value="db-sys"/>
        <env name="DB_SYSTEM_PORT" value="3306"/>
        <env name="DB_SYSTEM_DATABASE" value="nexus-testing-sys"/>
        <env name="DB_SYSTEM_USERNAME" value="root"/>
        <env name="DB_SYSTEM_PASSWORD" value="root"/>

        <!-- Master DB Testing -->
        <env name="DB_MASTER_HOST" value="db-mst"/>
        <env name="DB_MASTER_PORT" value="3306"/>
        <env name="DB_MASTER_DATABASE" value="nexus-testing-mst"/>
        <env name="DB_MASTER_USERNAME" value="root"/>
        <env name="DB_MASTER_PASSWORD" value="root"/>

        <!-- Log DB Testing (generic) -->
        <env name="DB_LOG_HOST" value="db-log"/>
        <env name="DB_LOG_PORT" value="3306"/>
        <env name="DB_LOG_DATABASE" value="nexus-testing-log"/>
        <env name="DB_LOG_USERNAME" value="root"/>
        <env name="DB_LOG_PASSWORD" value="root"/>

        <!-- Log DB Testing - Node 1 -->
        <env name="DB_LOG1_HOST" value="db-log1"/>
        <env name="DB_LOG1_PORT" value="3306"/>
        <env name="DB_LOG1_DATABASE" value="nexus-testing-log1"/>
        <env name="DB_LOG1_USERNAME" value="root"/>
        <env name="DB_LOG1_PASSWORD" value="root"/>

        <!-- Log DB Testing - Node 2 -->
        <env name="DB_LOG2_HOST" value="db-log2"/>
        <env name="DB_LOG2_PORT" value="3306"/>
        <env name="DB_LOG2_DATABASE" value="nexus-testing-log2"/>
        <env name="DB_LOG2_USERNAME" value="root"/>
        <env name="DB_LOG2_PASSWORD" value="root"/>

        <!-- Log DB Testing - Node 3 -->
        <env name="DB_LOG3_HOST" value="db-log3"/>
        <env name="DB_LOG3_PORT" value="3306"/>
        <env name="DB_LOG3_DATABASE" value="nexus-testing-log3"/>
        <env name="DB_LOG3_USERNAME" value="root"/>
        <env name="DB_LOG3_PASSWORD" value="root"/>

        <!-- Transaction DB Testing - Node 1 -->
        <env name="DB_TRX1_HOST" value="db-trx1"/>
        <env name="DB_TRX1_PORT" value="3306"/>
        <env name="DB_TRX1_DATABASE" value="nexus-testing-trx1"/>
        <env name="DB_TRX1_USERNAME" value="root"/>
        <env name="DB_TRX1_PASSWORD" value="root"/>

        <!-- Transaction DB Testing - Node 2 -->
        <env name="DB_TRX2_HOST" value="db-trx2"/>
        <env name="DB_TRX2_PORT" value="3306"/>
        <env name="DB_TRX2_DATABASE" value="nexus-testing-trx2"/>
        <env name="DB_TRX2_USERNAME" value="root"/>
        <env name="DB_TRX2_PASSWORD" value="root"/>

        <!-- Transaction DB Testing - Node 3 -->
        <env name="DB_TRX3_HOST" value="db-trx3"/>
        <env name="DB_TRX3_PORT" value="3306"/>
        <env name="DB_TRX3_DATABASE" value="nexus-testing-trx3"/>
        <env name="DB_TRX3_USERNAME" value="root"/>
        <env name="DB_TRX3_PASSWORD" value="root"/>
    </php>
</phpunit>
