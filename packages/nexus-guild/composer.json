{
    "name": "nexus/guild",
    "description": "Guild management package for Nexus framework",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "NexusGuild\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NexusGuild\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.4",
        "nexus/core": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "mockery/mockery": "^1.6"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../nexus-core"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
