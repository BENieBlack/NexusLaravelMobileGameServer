{
    "name": "nexus/core",
    "description": "Core package for Laravel game applications (Models, Repositories, Utilities, ValueObjects)",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "S. Nakamura"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/cache": "^10.0|^11.0|^12.0",
        "nesbot/carbon": "^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Nexus\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nexus\\Core\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nexus\\Core\\CoreServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
