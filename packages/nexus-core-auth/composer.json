{
    "name": "nexus/core-auth",
    "description": "Device-based authentication package for mobile games with OAuth2-style token management",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "NexusAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NexusAuth\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.4",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "firebase/php-jwt": "^6.10",
        "nexus/core": "@dev",
        "nexus/core-security": "@dev",
        "nexus/core-unit-of-work": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

