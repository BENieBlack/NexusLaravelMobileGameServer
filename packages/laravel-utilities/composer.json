{
    "name": "s-nakamura/laravel-utilities",
    "description": "Laravel utility classes including ClockUtility and RedisUtility",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "S. Nakamura"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/cache": "^11.0|^12.0",
        "nesbot/carbon": "^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "LaravelUtilities\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelUtilities\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
