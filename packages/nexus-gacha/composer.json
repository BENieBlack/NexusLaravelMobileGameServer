{
    "name": "nexus/gacha",
    "description": "Gacha management package for Nexus mobile game",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "nexus/core": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "NexusGacha\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NexusGacha\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NexusGacha\\GachaServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

