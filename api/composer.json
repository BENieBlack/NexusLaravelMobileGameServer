{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../packages/nexus-core"
        },
        {
            "type": "path",
            "url": "../packages/nexus-core-security"
        },
        {
            "type": "path",
            "url": "../packages/nexus-core-unit-of-work"
        },
        {
            "type": "path",
            "url": "../packages/nexus-core-auth"
        },
        {
            "type": "path",
            "url": "../packages/nexus-core-billing"
        },
        {
            "type": "path",
            "url": "../packages/nexus-wallet"
        },
        {
            "type": "path",
            "url": "../packages/nexus-maintenance"
        },
        {
            "type": "path",
            "url": "../packages/nexus-resource"
        },
        {
            "type": "path",
            "url": "../packages/nexus-resource-delivery"
        },
        {
            "type": "path",
            "url": "../packages/nexus-login"
        },
        {
            "type": "path",
            "url": "../packages/nexus-version"
        },
        {
            "type": "path",
            "url": "../packages/nexus-stamina"
        },
        {
            "type": "path",
            "url": "../packages/nexus-gacha"
        },
        {
            "type": "path",
            "url": "../packages/nexus-mailbox"
        },
        {
            "type": "path",
            "url": "../packages/nexus-vip"
        },
        {
            "type": "path",
            "url": "../packages/nexus-level"
        },
        {
            "type": "path",
            "url": "../packages/nexus-friend"
        },
        {
            "type": "path",
            "url": "../packages/nexus-album"
        },
        {
            "type": "path",
            "url": "../packages/nexus-tidb"
        },
        {
            "type": "path",
            "url": "../packages/nexus-guild"
        },
        {
            "type": "path",
            "url": "../packages/nexus-pitr"
        },
        {
            "type": "path",
            "url": "../packages/nexus-notification"
        },
        {
            "type": "path",
            "url": "../packages/nexus-chat"
        }
    ],
    "require": {
        "php": "^8.4",
        "doctrine/dbal": "^4.4",
        "firebase/php-jwt": "^6.10",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1",
        "nexus/core": "@dev",
        "nexus/core-security": "@dev",
        "nexus/core-unit-of-work": "@dev",
        "nexus/core-auth": "@dev",
        "nexus/core-billing": "@dev",
        "nexus/wallet": "@dev",
        "nexus/maintenance": "@dev",
        "nexus/resource": "@dev",
        "nexus/resource-delivery": "@dev",
        "nexus/login": "@dev",
        "nexus/version": "@dev",
        "nexus/stamina": "@dev",
        "nexus/gacha": "@dev",
        "nexus/mailbox": "@dev",
        "nexus/vip": "@dev",
        "nexus/level": "@dev",
        "nexus/friend": "@dev",
        "nexus/album": "@dev",
        "nexus/tidb": "@dev",
        "nexus/guild": "@dev",
        "nexus/pitr": "@dev",
        "nexus/notification": "@dev",
        "nexus/chat": "@dev"
    },
    "require-dev": {
        "aliyun/aliyun-tablestore-sdk-php": "^6.0",
        "aws/aws-sdk-php": "^3.394",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-arch": "^3.1",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "NexusAuth\\": "../packages/nexus-core-auth/src/",
            "NexusBilling\\": "../packages/nexus-core-billing/src/",
            "NexusFriend\\": "../packages/nexus-friend/src/",
            "NexusGacha\\": "../packages/nexus-gacha/src/",
            "NexusGuild\\": "../packages/nexus-guild/src/",
            "NexusLevel\\": "../packages/nexus-level/src/",
            "NexusLogin\\": "../packages/nexus-login/src/",
            "NexusMailbox\\": "../packages/nexus-mailbox/src/",
            "NexusMaintenance\\": "../packages/nexus-maintenance/src/",
            "NexusPitr\\": "../packages/nexus-pitr/src/",
            "NexusNotification\\": "../packages/nexus-notification/src/",
            "NexusChat\\": "../packages/nexus-chat/src/",
            "NexusResourceDelivery\\": "../packages/nexus-resource-delivery/src/",
            "NexusResource\\": "../packages/nexus-resource/src/",
            "NexusSecurity\\": "../packages/nexus-core-security/src/",
            "NexusStamina\\": "../packages/nexus-stamina/src/",
            "NexusUnitOfWork\\": "../packages/nexus-core-unit-of-work/src/",
            "NexusVersion\\": "../packages/nexus-version/src/",
            "NexusVip\\": "../packages/nexus-vip/src/",
            "NexusWallet\\": "../packages/nexus-wallet/src/",
            "Nexus\\Core\\": "../packages/nexus-core/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "App\\PHPStan\\": "phpstan/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "test:arch": [
            "./vendor/bin/pest --filter=Architecture"
        ],
        "phpstan": [
            "./vendor/bin/phpstan analyse --memory-limit=2G"
        ],
        "check": [
            "@phpstan",
            "@test:arch"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.4"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
