{
    "name": "nexus/notification",
    "description": "Nexusモバイルゲーム向けゲーム内通知配送インフラパッケージ",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "nexus/core": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/broadcasting": "^11.0|^12.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "NexusNotification\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NexusNotification\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NexusNotification\\NotificationServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
