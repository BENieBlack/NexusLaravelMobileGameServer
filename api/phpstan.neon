includes:
    - vendor/larastan/larastan/extension.neon
    # 既存の指摘はbaselineに退避し、新規に混入した分だけを検出する
    # baselineを減らす作業は別途進める
    - phpstan-baseline.neon

parameters:
    level: 6
    # 解析対象のPHPバージョンを固定する。
    # 実行環境のPHPに追従させると、CIとローカルで結果が変わる。
    phpVersion: 80400
    paths:
        - app
        - ../packages/nexus-core/src
        - ../packages/nexus-core-auth/src
        - ../packages/nexus-core-billing/src
        - ../packages/nexus-core-security/src
        - ../packages/nexus-core-unit-of-work/src
        - ../packages/nexus-friend/src
        - ../packages/nexus-gacha/src
        - ../packages/nexus-guild/src
        - ../packages/nexus-level/src
        - ../packages/nexus-login/src
        - ../packages/nexus-mailbox/src
        - ../packages/nexus-maintenance/src
        - ../packages/nexus-pitr/src
        - ../packages/nexus-player/src
        - ../packages/nexus-resource/src
        - ../packages/nexus-resource-delivery/src
        - ../packages/nexus-stamina/src
        - ../packages/nexus-version/src
        - ../packages/nexus-vip/src
        - ../packages/nexus-wallet/src
    excludePaths:
        - app/Providers/*
        - app/Console/*
    scanDirectories:
        - phpstan
    
    # カスタムルールの有効化
    bootstrapFiles:
        - phpstan/bootstrap.php

    ignoreErrors:
        # 外部ストレージ/課金SDKはオプション依存であり、
        # 該当ドライバを使う環境でのみ composer で追加する。
        # クラスが見つからないのは想定どおりなので個別に無視する。
        -
            identifier: class.notFound
            paths:
                - ../packages/nexus-maintenance/src/Infrastructure/DynamoDB/*
                - ../packages/nexus-maintenance/src/Infrastructure/TableStore/*
                - ../packages/nexus-core-billing/src/ApiClients/GooglePlayApiClient.php

rules:
    - App\PHPStan\Rules\NoDirectEloquentSaveInServiceRule
