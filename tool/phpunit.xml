<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <!--
            テストは専用のデータベースを使う。admin は migrate:fresh で作り直すため、
            開発用（nexus-local-admin）を指すと開発環境のアカウントが消える。
            sys / trx は api のテスト用（nexus-testing-system / -shard）と分ける。
            共用すると、ここで作ったプレイヤーが api の AssignPlayersCommandTest などを落とす。
            CI はジョブの環境変数で指定しており、そちらが優先される。
            ローカルのデータベースは make tool-check（tool-test-db）が作る。
        -->
        <env name="DB_ADMIN_DATABASE" value="nexus-testing-admin"/>
        <env name="DB_SYSTEM_DATABASE" value="nexus-testing-tool-system"/>
        <env name="DB_SHARD_DATABASE" value="nexus-testing-tool-shard"/>
        <!--
            シャード数は .env（.env.example は 3）に左右されないよう固定する。
            force を付けないと既存の環境変数が優先され、環境によって trx3 まで見に行く。
            api の phpunit.xml と揃える。
        -->
        <env name="DB_SHARD_COUNT" value="2" force="true"/>
        <server name="DB_SHARD_COUNT" value="2" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
