{
    "name": "nexus/login",
    "description": "Login bonus management for mobile games with daily reward cycles",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nexus Team",
            "email": "team@nexus.example.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0",
        "illuminate/database": "^12.0",
        "nesbot/carbon": "^2.0|^3.0",
        "nexus/resource": "*",
        "nexus/resource-delivery": "*",
        "nexus/utilities": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "NexusLogin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NexusLogin\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
