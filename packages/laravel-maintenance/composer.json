{
    "name": "laravel-mobile-rpg/maintenance",
    "description": "Maintenance mode management for Laravel with support for AWS DynamoDB and Alibaba Cloud TableStore",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Your Name",
            "email": "your.email@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/cache": "^10.0|^11.0|^12.0",
        "nesbot/carbon": "^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0"
    },
    "suggest": {
        "aws/aws-sdk-php": "Required for AWS DynamoDB storage driver (^3.0)",
        "aliyun/aliyun-tablestore-sdk-php": "Required for Alibaba Cloud TableStore storage driver"
    },
    "autoload": {
        "psr-4": {
            "LaravelMaintenance\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelMaintenance\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelMaintenance\\MaintenanceServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
