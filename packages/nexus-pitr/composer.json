{
    "name": "nexus/pitr",
    "description": "Point-In-Time Recovery system for TrxDB using LogDB change history",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Nexus Team"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/console": "^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "NexusPitr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NexusPitr\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage"
    },
    "extra": {
        "laravel": {
            "providers": [
                "NexusPitr\\NexusPitrServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
