<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mst"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="REDIS_HOST" value="redis"/>
        <env name="REDIS_PORT" value="6379"/>

        <!-- System DB Testing -->
        <env name="DB_SYSTEM_HOST" value="127.0.0.1"/>
        <env name="DB_SYSTEM_PORT" value="33062"/>
        <env name="DB_SYSTEM_DATABASE" value="arche-testing-sys"/>
        <env name="DB_SYSTEM_USERNAME" value="root"/>
        <env name="DB_SYSTEM_PASSWORD" value="root"/>

        <!-- Master DB Testing -->
        <env name="DB_MASTER_HOST" value="127.0.0.1"/>
        <env name="DB_MASTER_PORT" value="33063"/>
        <env name="DB_MASTER_DATABASE" value="arche-testing-mst"/>
        <env name="DB_MASTER_USERNAME" value="root"/>
        <env name="DB_MASTER_PASSWORD" value="root"/>

        <!-- Log DB Testing -->
        <env name="DB_LOG_HOST" value="127.0.0.1"/>
        <env name="DB_LOG_PORT" value="33064"/>
        <env name="DB_LOG_DATABASE" value="arche-testing-log"/>
        <env name="DB_LOG_USERNAME" value="root"/>
        <env name="DB_LOG_PASSWORD" value="root"/>

        <!-- Transaction DB Testing - Node 1 -->
        <env name="DB_TRX1_HOST" value="127.0.0.1"/>
        <env name="DB_TRX1_PORT" value="33065"/>
        <env name="DB_TRX1_DATABASE" value="arche-testing-trx1"/>
        <env name="DB_TRX1_USERNAME" value="root"/>
        <env name="DB_TRX1_PASSWORD" value="root"/>

        <!-- Transaction DB Testing - Node 2 -->
        <env name="DB_TRX2_HOST" value="127.0.0.1"/>
        <env name="DB_TRX2_PORT" value="33066"/>
        <env name="DB_TRX2_DATABASE" value="arche-testing-trx2"/>
        <env name="DB_TRX2_USERNAME" value="root"/>
        <env name="DB_TRX2_PASSWORD" value="root"/>
    </php>
</phpunit>
