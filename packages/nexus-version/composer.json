{
    "name": "nexus/version",
    "description": "Nexus Version Check Package - バージョンチェック・デプロイ管理パッケージ",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "NexusVersion\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NexusVersion\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5",
        "illuminate/support": "^13.0",
        "illuminate/cache": "^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "extra": {
        "laravel": {
            "providers": [
                "NexusVersion\\NexusVersionServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

