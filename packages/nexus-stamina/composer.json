{
    "name": "nexus/stamina",
    "description": "Nexus Stamina Package - スタミナ管理パッケージ",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "NexusStamina\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NexusStamina\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NexusStamina\\StaminaServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.5",
        "illuminate/support": "^13.0",
        "nexus/core": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "mockery/mockery": "^1.6"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
