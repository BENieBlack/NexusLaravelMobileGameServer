{
    "name": "nexus/login",
    "description": "Login bonus management for mobile games with daily reward cycles",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nexus Team",
            "email": "team@nexus.example.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "nesbot/carbon": "^2.0|^3.0",
        "nexus/core": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "NexusLogin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NexusLogin\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NexusLogin\\LoginServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
