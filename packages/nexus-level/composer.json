{
    "name": "nexus/level",
    "description": "Level and experience progression for Nexus mobile game",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "nexus/core-player": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "NexusLevel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NexusLevel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NexusLevel\\LevelServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
