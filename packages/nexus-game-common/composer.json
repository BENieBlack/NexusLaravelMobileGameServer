{
    "name": "nexus/game-common",
    "description": "Common game domain constants and utilities shared across all games",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "S. Nakamura"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "NexusGameCommon\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NexusGameCommon\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
