# このファイルがプロジェクト唯一の環境設定である。
# api/ と tool/ の bootstrap/app.php はどちらもリポジトリルートの .env を読むため、
# api/.env や tool/.env を置いても読み込まれない（置かないこと）。

# アプリケーション基本設定
# APP_KEY は setup.sh が自動生成する（空のまま置いておく）
APP_NAME=nexus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# メンテナンス機能のストレージドライバー: database, dynamodb, tablestore
MAINTENANCE_DRIVER=database

# Client Authentication
# クライアント認証用の秘密鍵
# 以下はサンプル値であり、リポジトリが公開されているため誰でも知り得る。
# local以外の環境でこの値のまま起動すると、署名検証が起動時にエラーで落ちる。
# 生成方法: openssl rand -hex 32
CLIENT_SECRET=your-secret-key-here-change-in-production

# ログ
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker MySQL の root パスワード（docker-compose.yml が参照する）
MYSQL_ROOT_PASSWORD=root

# TrxDB/LogDBのシャード数（trx1..trxN と log1..logN が生成される）
# docker-compose.yml が定義しているコンテナ数（3）を超えないこと
DB_TRX_SHARDS=3

# API - システムDB
DB_SYSTEM_HOST=db-sys
DB_SYSTEM_PORT=3306
DB_SYSTEM_DATABASE=${APP_NAME}-${APP_ENV}-sys
DB_SYSTEM_USERNAME=root
DB_SYSTEM_PASSWORD=root

# API - マスターDB
DB_MASTER_HOST=db-mst
DB_MASTER_PORT=3306
DB_MASTER_DATABASE=${APP_NAME}-${APP_ENV}-mst
DB_MASTER_USERNAME=root
DB_MASTER_PASSWORD=root

# API - トランザクションDB（シャード）
# 全シャード共通の設定。ホストとDB名はシャード番号が付く（db-trx → db-trx1, db-trx2, ...）
DB_TRANSACTION_HOST=db-trx
DB_TRANSACTION_PORT=3306
DB_TRANSACTION_DATABASE=${APP_NAME}-${APP_ENV}-trx
DB_TRANSACTION_USERNAME=root
DB_TRANSACTION_PASSWORD=root
# シャードごとに変える場合のみ DB_TRX1_HOST / DB_TRX1_DATABASE ... で上書きする。
# シャード数は上の DB_TRX_SHARDS で指定する。

# API - ログDB（PITR用。trxと同じ番号どうしが対応する）
# trxと同様に、ホストとDB名はシャード番号が付く（db-log → db-log1, db-log2, ...）
DB_LOG_HOST=db-log
DB_LOG_PORT=3306
DB_LOG_DATABASE=${APP_NAME}-${APP_ENV}-log
DB_LOG_USERNAME=root
DB_LOG_PASSWORD=root

# Tool - 管理者DB
DB_ADMIN_HOST=db-adm
DB_ADMIN_PORT=3306
DB_ADMIN_DATABASE=${APP_NAME}-${APP_ENV}-adm
DB_ADMIN_USERNAME=root
DB_ADMIN_PASSWORD=root

# Tool - 運営ツールDB
DB_TOOL_HOST=db-tol
DB_TOOL_PORT=3306
DB_TOOL_DATABASE=${APP_NAME}-${APP_ENV}-tol
DB_TOOL_USERNAME=root
DB_TOOL_PASSWORD=root

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# キャッシュ
CACHE_STORE=redis

# ----------------------------------------
# アプリ内課金
# ----------------------------------------
# Google Play: サービスアカウントJSONのパス、またはJSON文字列
# 未設定の場合、購入検証は PlatformApiException で失敗する
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT=

# App Store: App Store Connect の共有シークレット（/verifyReceipt 用）
APP_STORE_SHARED_SECRET=

# App Store Server API（返金確認・サブスク照会）
# 接続先: production / sandbox
APP_STORE_ENVIRONMENT=sandbox
# App Store Connect の「Keys > In-App Purchase」で発行した鍵の情報
APP_STORE_JWT_KEY_ID=
APP_STORE_JWT_ISSUER_ID=
APP_STORE_JWT_BUNDLE_ID=
# .p8ファイルのパス、またはPEM文字列そのもの
APP_STORE_JWT_PRIVATE_KEY=
# JWTの有効期間（秒）。Appleの上限は3600
APP_STORE_JWT_TTL=1800
# Apple Root CA - G3（PEMのパスまたは中身）。未設定なら証明書チェーンを検証しない
APP_STORE_JWT_ROOT_CERTIFICATE=

# ----------------------------------------
# Laravel標準（api/.env.example から集約）
# ----------------------------------------
# 既定の接続。シャーディングのため実際の接続は都度解決する
DB_CONNECTION=sqlite
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
MEMCACHED_HOST=127.0.0.1

# メール（Laravel標準の設定。現状アプリからの送信実装は無く、既定でログ出力のみ）
# tool側の管理アカウント通知などで使う想定のため残している
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ----------------------------------------
# ゲーム共通
# ----------------------------------------
# ゲーム内の日付が切り替わる時刻（ClockUtility）
DAY_START_TIME=00:00:00

# 冪等性チェック（X-Unique-Request-Identifier）
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_CACHE_TTL=86400

# PITR（trxの変更ログ）
PITR_BATCH_SIZE=1000
PITR_ENABLE_COMPRESSION=false

# ----------------------------------------
# メンテナンス
# ----------------------------------------
MAINTENANCE_ENABLED=true
MAINTENANCE_CACHE_TTL=60
# カンマ区切り（例: 192.168.1.1,10.0.0.1）
MAINTENANCE_EXCLUDED_IPS=

# MAINTENANCE_DRIVER=dynamodb を使う場合
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# ローカル開発時のみ（例: http://localhost:8000）
AWS_DYNAMODB_ENDPOINT=
AWS_DYNAMODB_MAINTENANCE_TABLE=sys_maintenance
AWS_DYNAMODB_MAINTENANCE_PRIMARY_KEY=SysMaintenance

# MAINTENANCE_DRIVER=tablestore を使う場合
ALIBABA_TABLESTORE_ENDPOINT=
ALIBABA_TABLESTORE_INSTANCE=
ALIBABA_TABLESTORE_ACCESS_KEY_ID=
ALIBABA_TABLESTORE_ACCESS_KEY_SECRET=
ALIBABA_TABLESTORE_MAINTENANCE_TABLE=sys_maintenance
ALIBABA_TABLESTORE_MAINTENANCE_PRIMARY_KEY=SysMaintenance

# ----------------------------------------
# 運営ツール（tool）
# ----------------------------------------
# 管理APIのトークンと接続元IP制限（カンマ区切り）
ADMIN_TOKEN=
ADMIN_ALLOWED_IPS=
