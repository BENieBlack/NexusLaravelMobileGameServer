APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

# シャーディング設定
# TrxDB/LogDBのシャード数（デフォルト: 2）
# 例: DB_TRX_SHARDS=4 の場合、trx1~trx4, log1~log4 を自動生成
DB_TRX_SHARDS=2

# マスターDB接続
DB_MASTER_HOST=db-mst
DB_MASTER_PORT=3306
DB_MASTER_DATABASE=
DB_MASTER_USERNAME=
DB_MASTER_PASSWORD=

# システムDB接続
DB_SYSTEM_HOST=db-sys
DB_SYSTEM_PORT=3306
DB_SYSTEM_DATABASE=
DB_SYSTEM_USERNAME=
DB_SYSTEM_PASSWORD=

# 管理DB接続
DB_ADMIN_HOST=db-adm
DB_ADMIN_PORT=3306
DB_ADMIN_DATABASE=
DB_ADMIN_USERNAME=
DB_ADMIN_PASSWORD=

# トランザクションDB接続 - ノード1
DB_TRX1_HOST=db-trx1
DB_TRX1_PORT=3306
DB_TRX1_DATABASE=
DB_TRX1_USERNAME=
DB_TRX1_PASSWORD=

# トランザクションDB接続 - ノード2
DB_TRX2_HOST=db-trx2
DB_TRX2_PORT=3306
DB_TRX2_DATABASE=
DB_TRX2_USERNAME=
DB_TRX2_PASSWORD=

# LogDB接続（PITR用） - シャード1
DB_LOG1_HOST=db-log1
DB_LOG1_PORT=3306
DB_LOG1_DATABASE=
DB_LOG1_USERNAME=
DB_LOG1_PASSWORD=

# LogDB接続（PITR用） - シャード2
DB_LOG2_HOST=db-log2
DB_LOG2_PORT=3306
DB_LOG2_DATABASE=
DB_LOG2_USERNAME=
DB_LOG2_PASSWORD=

# PITR設定
PITR_BATCH_SIZE=1000
PITR_ENABLE_COMPRESSION=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

# 冪等性キャッシュの設定
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_CACHE_TTL=86400  # 24時間（秒）

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis  # Docker環境ではコンテナ名、ローカルでは127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# 日付境界時刻の設定
# 1日の開始時刻（HH:MM:SS形式）
# 例: 09:00:00 → 1日は09:00:00~翌日08:59:59
# デフォルト: 00:00:00 → 1日は00:00:00~23:59:59
DAY_START_TIME=00:00:00

# メンテナンス機能の設定
MAINTENANCE_ENABLED=true
MAINTENANCE_DRIVER=dynamodb  # dynamodb or tablestore
MAINTENANCE_CACHE_TTL=60  # キャッシュTTL（秒）
MAINTENANCE_CACHE_KEY=maintenance:status
MAINTENANCE_EXCLUDED_IPS=  # カンマ区切り（例: 192.168.1.1,10.0.0.1）

# AWS DynamoDB設定（MAINTENANCE_DRIVER=dynamodb の場合）
AWS_DYNAMODB_ENDPOINT=  # ローカル開発時のみ（例: http://localhost:8000）
AWS_DYNAMODB_MAINTENANCE_TABLE=sys_maintenance
AWS_DYNAMODB_MAINTENANCE_PRIMARY_KEY=SysMaintenance

# Alibaba Cloud TableStore設定（MAINTENANCE_DRIVER=tablestore の場合）
ALIBABA_TABLESTORE_ENDPOINT=
ALIBABA_TABLESTORE_INSTANCE=
ALIBABA_TABLESTORE_ACCESS_KEY_ID=
ALIBABA_TABLESTORE_ACCESS_KEY_SECRET=
ALIBABA_TABLESTORE_MAINTENANCE_TABLE=sys_maintenance
ALIBABA_TABLESTORE_MAINTENANCE_PRIMARY_KEY=SysMaintenance

# 管理者API認証設定
# ADMIN_TOKEN: 管理者APIへのアクセスに使用するBearerトークン（強力なランダム文字列を設定）
# ADMIN_ALLOWED_IPS: 管理者APIアクセスを許可するIPアドレスのカンマ区切りリスト（オプション）
ADMIN_TOKEN=
ADMIN_ALLOWED_IPS=

VITE_APP_NAME="${APP_NAME}"
