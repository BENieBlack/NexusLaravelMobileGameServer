{
    "name": "nexus/core-player",
    "description": "Player entity package for Nexus mobile game (identity, devices, shard routing)",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "nexus/core": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "NexusPlayer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NexusPlayer\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NexusPlayer\\PlayerServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
