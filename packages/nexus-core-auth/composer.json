{
    "name": "nexus/core-auth",
    "description": "Device-based authentication package for mobile games with OAuth2-style token management",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "NexusAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NexusAuth\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "firebase/php-jwt": "^7.0",
        "nexus/core": "@dev",
        "nexus/core-security": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "extra": {
        "laravel": {
            "providers": [
                "NexusAuth\\AuthServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

