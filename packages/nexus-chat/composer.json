{
    "name": "nexus/chat",
    "description": "Nexusモバイルゲーム向けチャットパッケージ（フレンドDM・ギルド・グループチャット / Laravel Reverb対応）",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "nexus/core": "@dev",
        "nexus/notification": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/broadcasting": "^11.0|^12.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "NexusChat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NexusChat\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../nexus-notification"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "NexusChat\\ChatServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
