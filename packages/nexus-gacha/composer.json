{
    "name": "nexus/gacha",
    "description": "Gacha management package for Nexus mobile game",
    "type": "library",
    "require": {
        "php": "^8.3",
        "nexus/utilities": "@dev",
        "nexus/resource-delivery": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "NexusGacha\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NexusGacha\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

