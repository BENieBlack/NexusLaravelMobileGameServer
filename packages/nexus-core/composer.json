{
    "name": "nexus/core",
    "description": "Core package for Laravel game applications (Models, Repositories, Utilities, ValueObjects)",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "S. Nakamura"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/cache": "^13.0",
        "nesbot/carbon": "^2.0|^3.0",
        "psr/log": "^1.1|^2.0|^3.0",
        "ramsey/uuid": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Nexus\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nexus\\Core\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nexus\\Core\\CoreServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
